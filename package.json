{
  "name": "fieldtest",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "check": "biome check && bun run --filter '*' check",
    "test": "bun run --filter '*' test",
    "build": "bun run --filter '*' build",
    "db:generate": "bun run --filter @app/db db:generate",
    "format": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@sveltejs/kit": {
      "cookie": "0.7.2"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "license": "AGPL-3.0-or-later"
}
