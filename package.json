{
  "name": "fieldtest",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "check": "biome check && bun run --filter '*' check",
    "test": "bun run --filter '*' test",
    "build": "bun run --filter '*' build",
    "db:generate": "bun run --filter @app/db db:generate",
    "format": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
