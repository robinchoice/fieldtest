FROM oven/bun:1-slim AS build
WORKDIR /app

COPY package.json bun.lock tsconfig.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/db/package.json packages/db/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN bun install --frozen-lockfile

COPY packages packages
COPY apps/web apps/web
RUN cd apps/web && bun run build

# adapter-node bundles every devDependency, so the build runs without node_modules
FROM oven/bun:1-slim
WORKDIR /app
COPY --from=build /app/apps/web/build build
ENV NODE_ENV=production PORT=3000
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=5s --retries=5 \
  CMD bun -e "fetch('http://localhost:3000/').then(r => process.exit(r.ok ? 0 : 1), () => process.exit(1))"
# The base image ships the unprivileged user bun
USER bun
CMD ["bun", "build/index.js"]
