# Local dev. Copy to .env, then: docker compose up -d && bun run dev
DATABASE_URL=postgresql://app:app@localhost:5433/app
APP_URL=http://localhost:5173

# Optional. Without SMTP_HOST login links are printed to the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Optional. Empty DSN = GlitchTip off.
SENTRY_DSN=
