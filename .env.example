# Local dev. Copy to .env, then: docker compose up -d && bun run dev
DATABASE_URL=postgresql://app:app@localhost:5437/app
APP_URL=http://localhost:5173

# Optional in dev: without SMTP_HOST login links are printed to the API log.
# In production (NODE_ENV=production) the API refuses to start without it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Optional. With a key every tester report is evaluated by Claude.
ANTHROPIC_API_KEY=

# Lets a runner in test mode (DRY_RUN=1) report made-up payments. Never in production.
ALLOW_FAKE_PAYMENTS=1

# Optional. Empty DSN = GlitchTip off.
SENTRY_DSN=
