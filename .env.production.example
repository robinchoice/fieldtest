# Environment variables of the Coolify resource.
# IMAGE_PREFIX and IMAGE_TAG are set by the CI on every deploy.

# Public URL without trailing slash
APP_URL=https://example.pleasance.org
API_INTERNAL_URL=http://api:3000

# openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
# Memory limit of Postgres, default 512m
POSTGRES_MEMORY=

# Required, the API does not start without SMTP_HOST.
# Proton SMTP: the password is the SMTP token of the sender address.
# Business senders use noreply@pleasance.org, private ones noreply@diespaetzles.lol.
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USER=noreply@pleasance.org
SMTP_PASS=CHANGE_ME
EMAIL_FROM=Fieldtest <noreply@pleasance.org>

# Sign-up stays closed until Robin's go (README, „Registrierung öffnen“):
# existing accounts log in, new ones only for these comma-separated addresses (Robin, testers).
SIGNUP_ALLOWLIST=
# Only after Robin's go: true = everyone may sign up
SIGNUP_OPEN=
# Comma-separated addresses that see „Tester einladen“ in the app and may invite testers.
# robin@pleasance.org is the human admin. Never admin@pleasance.org, the agents' account.
ADMIN_EMAILS=robin@pleasance.org

# Optional, only for the worker. With a key every tester report is evaluated by Claude, see apps/api/src/lib/evaluate.ts
ANTHROPIC_API_KEY=

# GlitchTip DSN of this project, used by API, web server and browser
SENTRY_DSN=
PUBLIC_SENTRY_DSN=
