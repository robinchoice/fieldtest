FROM oven/bun:1-slim
WORKDIR /app

COPY package.json bun.lock tsconfig.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/db/package.json packages/db/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/sdk/package.json packages/sdk/
COPY apps/runner/package.json apps/runner/
COPY apps/cli/package.json apps/cli/
RUN bun install --frozen-lockfile --production

COPY packages packages
COPY apps/api apps/api
# Drafts of update mails, imported on start
COPY updates updates

# Set by CI: /api/health and feedback report the commit, feedback files issues in this repo
ARG APP_VERSION=dev
ARG GITHUB_REPOSITORY=
ENV NODE_ENV=production APP_VERSION=$APP_VERSION GITHUB_REPOSITORY=$GITHUB_REPOSITORY
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=5s --retries=5 \
  CMD bun -e "fetch('http://localhost:3000/api/health').then(r => process.exit(r.ok ? 0 : 1), () => process.exit(1))"
# The base image ships the unprivileged user bun
USER bun
CMD ["bun", "apps/api/src/index.ts"]
